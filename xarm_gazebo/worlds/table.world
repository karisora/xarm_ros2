<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <!-- <include>
      <uri>model://ground_plane</uri>
    </include> -->
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="stage_table">
      <static>true</static>
      <pose>0 0 0.0065 1.5708 0 0</pose>
      <link name="stage_link">
        <visual name="stage_visual">
          <geometry>
            <mesh>
              <uri>file:///root/dev_ws/src/xarm_ros2/xarm_description/meshes/gripper/xarm/stage.stl</uri>
              <scale>0.1 0.1 0.1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="stage_collision">
          <geometry>
            <mesh>
              <uri>file:///home/karisora/dev_ws/src/xarm_ros2/xarm_description/meshes/gripper/xarm/stage.stl</uri>
              <scale>0.1 0.1 0.1</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- (2022-12-20) humble: change gravity from [0 0 -9.81] to [0 0 0] -->
      <gravity>0 0 0</gravity>
    </physics>

  </world>
</sdf>
